{
  "name": "promotional-offer-signer",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that signs App Store promotional offers (Apple's JWS format) for ZTronPaywallKit, so the In-App Purchase key never ships in an app.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.0.0"
  }
}
