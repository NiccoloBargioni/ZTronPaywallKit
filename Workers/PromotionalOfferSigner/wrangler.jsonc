// Cloudflare Worker configuration. Deploy with `npm run deploy` after `wrangler login`.
//
// Nothing here identifies your account or app: the key, its id, the issuer id and the bundle ids are Worker
// secrets (`wrangler secret put <NAME>`, see README.md), never values in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promotional-offer-signer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  }
  // Optional volume bound per client IP (see README.md, "Security model"): uncomment to bind RATE_LIMITER. `limit`
  // requests per `period` seconds (10 or 60); keep it generous, carrier-grade NAT shares one address among many
  // customers. `namespace_id` is any positive integer unique among this account's rate limits.
  // ,"ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }]
}
